# Copy to .env and fill in.
# Your deployed GermanFlow site on Vercel. HTTPS only; no trailing slash.
API_URL=https://your-app.vercel.app
# Where the GermanFlow web project lives (its client is reused for the desktop app).
WEB_APP_DIR=../Deutsch App
# Shown on the privacy page.
CONTACT_EMAIL=your-email@example.com
